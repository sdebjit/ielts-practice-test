[Unit]
Description=IELTS Master Full-Stack Application Server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/ielts-gemini-prep
ExecStart=/usr/bin/python3 /opt/ielts-gemini-prep/backend/server.py 8080
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
